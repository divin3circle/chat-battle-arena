# Local dev database
MYSQL_BASE_URL=sqlite:///./chat_battle_arena.db

# Twitch Extension shared secret from Twitch Developer Console.
# Keep this base64 value as Twitch provides it; backend decodes it.
TWITCH_EXT_SECRET=replace_with_twitch_extension_shared_secret

# true for localhost/dev fallback, false for real Twitch Extension auth enforcement.
DEV_AUTH_BYPASS=false
